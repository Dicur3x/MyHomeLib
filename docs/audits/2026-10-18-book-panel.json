  "recorded_utc": "2026-10-19T21:07:14.035047+00:00",
  "status": "Panel resize, wheel, filter-action order and six-case performance checks pass on x86/x64. Release remains unpublished; wider release gates are separate.",
  "base_commit": "9cec4c91",
  "production_changes": [
    "Guard missing selected row/value before copying information to the clipboard.",
    "Compute cover and viewport bounds together from final panel client size, after the shared OnResize callback.",
    "Scroll the explicit metadata range with the system wheel preference; scroll the unfocused native memo and forward wheel at its edge.",
    "Skip redundant content-child automatic alignment; all direct children retain explicit measured layout.",
    "Insert the reset-column-filters action before the complete right-aligned language/total group, including when shown again."
  ],
  "test_changes": [
    "Native empty-selection/missing-value copy regressions.",
    "Repeated splitter-height transitions with non-overlap and final cover-height assertions.",
    "Native wheel scrolling over metadata and an unfocused annotation, including the bottom edge and fixed footer.",
    "Reset/language order after repeated hiding/showing in all language-bearing book tabs at 96/144/192 PPI and both themes.",
    "Original 100-selection loop and <5000ms predicate preserved, with UI-thread CPU measured separately.",
    "Failure paths flush output and exit with code 1 without running unit finalizers while live VCL timers remain."
  ],
  "ordinary_app_archives": "Existing candidate archives predate the new clipboard guard and must be rebuilt after final source changes.",
