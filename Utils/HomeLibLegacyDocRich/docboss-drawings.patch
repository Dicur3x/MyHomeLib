+/// Word stores empty raster fallbacks for a SHAPE field as a self-contained
+/// inline picture frame. A frame with a link, BLIP, border or other drawing
+/// data is not this placeholder, even if its image decoder returned None.
+pub fn empty_shape_preview(data: &[u8], at: usize) -> bool {
+    fn frame(data: &[u8], at: usize) -> Option<bool> {
+        let end = at.checked_add(u32_at(data, at)? as usize)?;
+        let data = data.get(at..end)?;
+        if u16_at(data, 4)? != 68 || u16_at(data, 6)? != 0x0064
+            || data.get(46..62)?.iter().any(|&byte| byte != 0)
+        {
+            return None;
+        }
+        let payload = data.get(68..)?;
+        // Read lengths from the headers rather than accepting clamped records.
+        let mut remaining = payload;
+        let body = take_shape_record(&mut remaining, 0x000F, 0xF004)?;
+        if !remaining.is_empty() {
+            return None;
+        }
+        let mut contents = body;
+        let shape = take_shape_record(&mut contents, (75 << 4) | 2, 0xF00A)?;
+        if shape.len() != 8 || u32_at(shape, 4)? != 0x0000_0A00 {
+            return None;
+        }
+        let options_header = u16_at(contents, 0)?;
+        let options = take_shape_record(&mut contents, options_header, 0xF00B)?;
+        let expected_size = match options_header {
+            0x0033 => 18,
+            0x0053 => 30,
+            _ => return None,
+        };
+        if options.len() != expected_size
+            || u16_at(options, 0)? != 0x007F
+            || !matches!(u32_at(options, 2)?, 0x0140_0000 | 0x0140_0140)
+            || u16_at(options, 6)? != 0x0100 || u32_at(options, 8)? != 0xFFFF_0010
+            || u16_at(options, 12)? != 0x0101 || u32_at(options, 14)? != 0x0000_FFF0
+        {
+            return None;
+        }
+        if expected_size == 30 && (u16_at(options, 18)? != 0x0181
+            || u16_at(options, 24)? != 0x01BF || u32_at(options, 26)? != 0x0010_0000)
+        {
+            return None;
+        }
+        if u16_at(contents, 2)? == 0xF122 {
+            let options = take_shape_record(&mut contents, 0x0013, 0xF122)?;
+            if options.len() != 6 || u16_at(options, 0)? != 0x053F
+                || u32_at(options, 2)? != 0x0001_0001
+            {
+                return None;
+            }
+        }
+        let anchor = take_shape_record(&mut contents, 0, 0xF010)?;
+        Some(anchor.len() == 4 && u32_at(anchor, 0)? & 0x8000_0000 != 0 && contents.is_empty())
+    }
+
+    fn take_shape_record<'a>(data: &mut &'a [u8], header: u16, kind: u16) -> Option<&'a [u8]> {
+        if u16_at(data, 0)? != header || u16_at(data, 2)? != kind {
+            return None;
+        }
+        let end = HEADER.checked_add(u32_at(data, 4)? as usize)?;
+        let body = data.get(HEADER..end)?;
+        *data = data.get(end..)?;
+        Some(body)
+    }
+
+    frame(data, at) == Some(true)
+}
