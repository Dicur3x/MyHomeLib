+            let mut shape = shape(75, 0xA00, &properties);
+            shape.extend(header(0, 0, 0xF010, 4));
+            shape.extend(0x8000_04D6u32.to_le_bytes());
+            let shape_len = (shape.len() - HEADER) as u32;
+            shape[4..8].copy_from_slice(&shape_len.to_le_bytes());
+            if blip {
+                // A BLIP with no data is a damaged image, not this placeholder.
+                shape.extend(header(0, 0, 0xF01E, 0));
+            }
+            let mut data = vec![0u8; 68];
+            data[0..4].copy_from_slice(&((68 + shape.len()) as u32).to_le_bytes());
+            data[4..6].copy_from_slice(&68u16.to_le_bytes());
+            data[6..8].copy_from_slice(&0x0064u16.to_le_bytes());
+            if border {
+                data[46] = 1;
+            }
+            data.extend(shape);
+            data
+        };
+        let empty = preview(false, false, false);
+        assert!(empty_shape_preview(&empty, 0));
+        assert!(!empty_shape_preview(&empty[..empty.len() - 1], 0));
+        assert!(!empty_shape_preview(&preview(true, false, false), 0));
+        assert!(!empty_shape_preview(&preview(false, true, false), 0));
+        assert!(!empty_shape_preview(&preview(false, false, true), 0));
+    }
