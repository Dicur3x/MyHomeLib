    <ProjectName>HomeLibDjvu</ProjectName><SanitizedProjectName>HomeLibDjvu</SanitizedProjectName>
    <Base>true</Base><Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win32</Platform><TargetedPlatforms>1</TargetedPlatforms>
    <AppType>Console</AppType><FrameworkType>None</FrameworkType>
    <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
    <DCC_Namespace>System;System.Win;Winapi;$(DCC_Namespace)</DCC_Namespace>
    <DCC_ExeOutput>Out\$(Platform)</DCC_ExeOutput><DCC_DcuOutput>Out\$(Platform)\dcu</DCC_DcuOutput>
