  </ItemGroup>
  <ProjectExtensions><Borland.Personality>Delphi.Personality.12</Borland.Personality><Borland.ProjectType>Console</Borland.ProjectType><BorlandProject><Platforms><Platform value="Win32">True</Platform></Platforms></BorlandProject></ProjectExtensions>
