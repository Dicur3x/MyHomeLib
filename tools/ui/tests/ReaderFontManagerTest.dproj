<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{16D84D21-B692-4DF1-A046-763BD78119DB}</ProjectGuid>
    <MainSource>ReaderFontManagerTest.dpr</MainSource>
    <ProjectVersion>20.3</ProjectVersion>
    <ProjectName>ReaderFontManagerTest</ProjectName>
    <SanitizedProjectName>ReaderFontManagerTest</SanitizedProjectName>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <Manifest_File>NativeRegression.manifest</Manifest_File>
    <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
    <DCC_UnitSearchPath>..\..\..\Program\Units;..\..\..\Program\Forms;..\..\..\Components\MHLComponents\Units;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_Namespace>System;System.Win;Winapi;Vcl;Vcl.Imaging;$(DCC_Namespace)</DCC_Namespace>
    <DCC_ExeOutput>Out\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>Out\$(Platform)\ReaderFontManagerTest-dcu</DCC_DcuOutput>
    <DCC_Assertions>true</DCC_Assertions>
    <DCC_RangeChecking>true</DCC_RangeChecking>
