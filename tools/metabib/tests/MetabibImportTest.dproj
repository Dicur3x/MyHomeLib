<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ProjectGuid>{F7032877-7FA3-4F52-A5F9-C475AEA4987C}</ProjectGuid>
    <MainSource>MetabibImportTest.dpr</MainSource>
    <ProjectVersion>20.3</ProjectVersion>
    <ProjectName>MetabibImportTest</ProjectName>
    <SanitizedProjectName>MetabibImportTest</SanitizedProjectName>
    <Base>true</Base>
    <Config Condition="'$(Config)'==''">Release</Config>
    <Platform Condition="'$(Platform)'==''">Win64</Platform>
    <TargetedPlatforms>3</TargetedPlatforms>
    <AppType>Console</AppType>
    <FrameworkType>VCL</FrameworkType>
    <Manifest_File>..\..\ui\tests\NativeRegression.manifest</Manifest_File>
    <VerInfo_IncludeVerInfo>false</VerInfo_IncludeVerInfo>
    <DCC_UnitSearchPath>..\..\..\Program\Units;..\..\..\Program\Forms;..\..\..\Program\Forms\Editors;..\..\..\Program\DataModules;..\..\..\Program\ImportImpl;..\..\..\Program\UtilsImpl;..\..\..\Program\DwnldImpl;..\..\..\Program\DAO;..\..\..\Program\DAO\SQLite;..\..\..\Program\DAO\SQLite\Lib;..\..\..\Program\Wizards\NewCollection;..\..\..\Program\Wizards\Base;..\..\..\Components\MHLComponents;..\..\..\Components\MHLComponents\Units;..\..\..\Components\VirtualTreeView\Source;..\..\..\tools\ui\tests;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
    <DCC_ResourcePath>..\..\..\Components\MHLComponents;$(DCC_ResourcePath)</DCC_ResourcePath>
    <DCC_IncludePath>..\..\..\Components\MHLComponents;$(DCC_IncludePath)</DCC_IncludePath>
    <DCC_Namespace>Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;System.Win;Xml;Xml.Win;Data;Data.Win;Datasnap;Datasnap.Win;Web;Web.Win;Soap;Soap.Win;Winapi;Bde;$(DCC_Namespace)</DCC_Namespace>
    <DCC_UnitAlias>WinTypes=Winapi.Windows;WinProcs=Winapi.Windows;$(DCC_UnitAlias)</DCC_UnitAlias>
    <DCC_ExeOutput>Out\$(Platform)</DCC_ExeOutput>
    <DCC_DcuOutput>Out\$(Platform)\MetabibImportTest-dcu</DCC_DcuOutput>
    <DCC_DependencyCheckOutputName>Out\$(Platform)\MetabibImportTest.exe</DCC_DependencyCheckOutputName>
    <DCC_Assertions>true</DCC_Assertions>
    <DCC_RangeChecking>true</DCC_RangeChecking>
    <DCC_OverflowChecking>true</DCC_OverflowChecking>
    <DCC_Optimize>false</DCC_Optimize>
    <DCC_DebugInformation>0</DCC_DebugInformation>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''"><Base>true</Base></PropertyGroup>
  <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_1)'!=''"><Cfg_1>true</Cfg_1><CfgParent>Base</CfgParent><Base>true</Base></PropertyGroup>
  <ItemGroup>
    <DelphiCompile Include="$(MainSource)"><MainSource>MainSource</MainSource></DelphiCompile>
    <DCCReference Include="..\..\ui\tests\NativeRegressionGuard.pas"/>
    <BuildConfiguration Include="Base"><Key>Base</Key></BuildConfiguration>
    <BuildConfiguration Include="Release"><Key>Cfg_1</Key><CfgParent>Base</CfgParent></BuildConfiguration>
  </ItemGroup>
  <ProjectExtensions><Borland.Personality>Delphi.Personality.12</Borland.Personality><Borland.ProjectType>Console</Borland.ProjectType><BorlandProject><Platforms><Platform value="Win32">True</Platform><Platform value="Win64">True</Platform></Platforms></BorlandProject></ProjectExtensions>
  <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
  <PropertyGroup><NameSpace>Vcl;Vcl.Imaging;Vcl.Touch;Vcl.Samples;Vcl.Shell;System;System.Win;Xml;Xml.Win;Data;Data.Win;Datasnap;Datasnap.Win;Web;Web.Win;Soap;Soap.Win;Winapi;Bde</NameSpace></PropertyGroup>
