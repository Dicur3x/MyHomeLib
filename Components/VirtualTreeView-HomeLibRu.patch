 //----------------------------------------------------------------------------------------------------------------------
 
+function TBaseVirtualTree.CachedVisibleNeighbour(Node: PVirtualNode; Forward: Boolean;
+  out Neighbour: PVirtualNode): Boolean;
+var L, H, I, Comparison: Integer;
+begin
+  Result := False; Neighbour := nil;
+  // A dense cache indexes a sparse filtered result without scanning hidden siblings.
+  // Existing cache invalidation stops readers before any node is changed or freed.
+  if not (tsUseCache in FStates) or (Length(FPositionCache) = 0) or
+    (Cardinal(Length(FPositionCache)) <> FVisibleCount) then Exit;
+  L := 0; H := High(FPositionCache);
+  while L <= H do
+  begin
+    I := (L + H) shr 1;
+    Comparison := CompareNodePositions(FPositionCache[I].Node, Node);
+    if Comparison < 0 then L := I + 1
+    else if Comparison > 0 then H := I - 1
+    else
+    begin
+      if Forward then Inc(I) else Dec(I);
+      if (I >= 0) and (I < Length(FPositionCache)) then Neighbour := FPositionCache[I].Node;
+      Exit(True);
+    end;
+  end;
+end;
