+    #[test]
+    fn image_inside_nested_link_preserves_resource_link_and_text_order() {
+        let mut chapter = Chapter::new();
+        let para = chapter.alloc_node(Node::new(Role::Paragraph));
+        chapter.append_child(chapter.root(), para);
+        text_child(&mut chapter, para, "before ");
+        let link = chapter.alloc_node(Node::new(Role::Link));
+        chapter.append_child(para, link);
+        chapter.semantics.set_href(link, "https://example.org/illustration");
+        text_child(&mut chapter, link, "linked ");
+        let span = chapter.alloc_node(Node::new(Role::Inline));
+        chapter.append_child(link, span);
+        image_child(&mut chapter, span, "animated.gif");
+        text_child(&mut chapter, link, " caption");
+        text_child(&mut chapter, para, " after");
+
+        let (ion, mut ctx) = export(&chapter);
+        let IonValue::List(elems) = ion else { panic!() };
+        let para_ion = as_struct(&elems[0]);
+        assert!(field(para_ion, KfxSymbol::Content).is_none());
+        let Some(IonValue::List(kids)) = field(para_ion, KfxSymbol::ContentList) else { panic!() };
+        assert_eq!(kids.len(), 5, "text, linked text, image, linked text, text: {kids:#?}");
+        let image = as_struct(&kids[2]);
+        assert!(field(image, KfxSymbol::ResourceName).is_some());
+        assert!(field(image, KfxSymbol::LinkTo).is_some());
+        for run in [0, 1, 3, 4] {
+            let fields = as_struct(&kids[run]);
+            assert!(field(fields, KfxSymbol::Content).is_some());
+            assert!(field(fields, KfxSymbol::ContentList).is_none());
+        }
+        let chunks = ctx.take_content_chunks();
+        let all: Vec<&String> = chunks.iter().flat_map(|(_, segs)| segs).collect();
+        assert_eq!(all, ["before ", "linked ", " caption", " after"]);
+    }
+
