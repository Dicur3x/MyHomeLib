+/// Images inside links/spans are element children, not text style events.
+/// Look through inline wrappers so their block parent also splits text runs.
+fn inline_contains_image(chapter: &Chapter, node_id: NodeId) -> bool {
+    chapter.node(node_id).is_some_and(|node| match node.role {
+        Role::Image => true,
+        Role::Link | Role::Inline => chapter
+            .children(node_id)
+            .any(|child| inline_contains_image(chapter, child)),
+        _ => false,
+    })
 }

