+// Opening KFX reads its metadata/resource index, not chapter contents. A missing
+// declaration stays missing; never promote an arbitrary first illustration.
+fn declared_cover(path: &str) -> Result<Option<Vec<u8>>, String> {
+    let metadata = std::fs::metadata(path).map_err(|e| e.to_string())?;
+    if !metadata.is_file() || metadata.len() > 64 * 1024 * 1024 {
+        return Err("Cover input must be a regular file of at most 64 MiB".into());
+    }
+    let book = Book::open_format(path, Format::Kfx).map_err(|e| e.to_string())?;
+    let Some(name) = book.metadata().cover_image.as_deref() else {
+        return Ok(None);
+    };
+    if name.trim().is_empty() {
+        return Err("Empty declared cover reference".into());
+    }
+    let image = book.load_asset(name).map_err(|e| e.to_string())?;
+    if image.is_empty() || image.len() > 16 * 1024 * 1024 {
+        return Err("Declared cover exceeds 16 MiB or is empty".into());
+    }
+    let raster = image.starts_with(b"\x89PNG\r\n\x1a\n")
+        || image.starts_with(b"\xff\xd8\xff")
+        || image.starts_with(b"GIF87a") || image.starts_with(b"GIF89a")
+        || (image.starts_with(b"RIFF") && image.get(8..12) == Some(b"WEBP"));
+    if !raster {
+        return Err("Declared cover is not a supported raster image".into());
+    }
+    Ok(Some(image))
+}
+
+fn write_cover(path: &str) -> Result<(), String> {
+    use std::io::Write;
+    if let Some(image) = declared_cover(path)? {
+        std::io::stdout().lock().write_all(&image).map_err(|e| e.to_string())?;
+    }
+    Ok(())
 }

