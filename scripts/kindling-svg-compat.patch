+#[cfg(test)]
+#[test]
+fn svg_image_hrefs_embed_without_changing_navigation() {
+    use std::collections::{HashMap, HashSet};
+    let html = r#"<html><body><svg:svg><svg:image xlink:href="../Images/pic.jpg"/><svg:image href="../Images/pic.jpg"/></svg:svg><a href="next.xhtml#chapter">Next</a></body></html>"#;
+    let mut aid = 0;
+    let images = HashMap::from([("pic.jpg".to_string(), 7usize)]);
+    let result = process_kf8_part(html, &mut aid, &images, &HashSet::new(), false);
+    let image = format!("kindle:embed:{}?mime=image/jpg", encode_base32_4char(7));
+    assert!(result.contains(&format!("xlink:href=\"{}\"", image)));
+    assert!(result.contains(&format!("href=\"{}\"", image)));
+    assert!(result.contains("href=\"next.xhtml#chapter\""));
+}
