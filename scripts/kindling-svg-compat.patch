+    // Rewrite image src and SVG (xlink:)href to Kindle image records.
+    let src_re = Regex::new(r#"(?i)\b(src|href)\s*=\s*"([^"]*)""#).unwrap();
+    result = src_re
+        .replace_all(&result, |caps: &regex::Captures| {
+            let attribute = caps.get(1).unwrap().as_str();
+            let src_path = caps.get(2).unwrap().as_str();
+            if let Some(&recindex) = path_to_recindex.get(src_path) {
+                format!(
+                    "{}=\"kindle:embed:{}?mime=image/{}\"",
+                    attribute,
+                    encode_base32_4char(recindex),
+                    mime_suffix
+                )
+            } else if let Some(fname) = src_path.rsplit('/').next() {
+                if let Some(&recindex) = path_to_recindex.get(fname) {
+                    format!(
+                        "{}=\"kindle:embed:{}?mime=image/{}\"",
+                        attribute,
+                        encode_base32_4char(recindex),
+                        mime_suffix
+                    )
+                } else {
+                    caps.get(0).unwrap().as_str().to_string()
+                }
+            } else {
+                caps.get(0).unwrap().as_str().to_string()
+            }
+        })
