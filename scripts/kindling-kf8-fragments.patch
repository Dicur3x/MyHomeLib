+fn fragment_target(fragments: &[FragmentEntry], file: usize, offset: usize) -> (usize, usize) {
+    let start = fragments.partition_point(|fragment| fragment.file_number < file);
+    let end = fragments.partition_point(|fragment| fragment.file_number <= file);
+    let section = &fragments[start..end];
+    let position = section.partition_point(|fragment| fragment.start_pos <= offset);
+    section.get(position.saturating_sub(1)).map_or((file, offset), |fragment| {
+        (fragment.sequence_number, offset - fragment.start_pos)
+    })
+}
+
+const MAX_KF8_FRAGMENT_BYTES: usize = 8192;
+
+fn fragment_ends(body: &str, kindlegen_parity: bool) -> Vec<usize> {
+    if kindlegen_parity || body.len() <= MAX_KF8_FRAGMENT_BYTES {
+        return vec![body.len()];
+    }
+    let mut blocks = Vec::new();
+    let mut tag_edges = Vec::new();
+    let mut plain_text = Vec::new();
+    let mut previous_tag = 0;
+    links::for_each_tag(body, |tag, _| {
+        if previous_tag < tag.start && !body[previous_tag..tag.start].contains('<') {
+            plain_text.push(previous_tag..tag.start);
+        }
+        tag_edges.extend([tag.start, tag.end]);
+        if tag.closing && matches!(tag.name.as_str(),
+            "p" | "div" | "li" | "blockquote" | "section" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6") {
+            blocks.push(tag.end);
+        }
+        previous_tag = tag.end;
+    });
+    if previous_tag < body.len() && !body[previous_tag..].contains('<') {
+        plain_text.push(previous_tag..body.len());
+    }
+
+    let mut ends = Vec::new();
+    let mut start = 0;
+    while body.len() - start > MAX_KF8_FRAGMENT_BYTES {
+        let limit = start + MAX_KF8_FRAGMENT_BYTES;
+        let last_before = |edges: &[usize]| {
+            let offset = edges.partition_point(|end| *end <= limit);
+            offset.checked_sub(1).map(|i| edges[i]).filter(|end| *end > start)
+        };
+        let cut = last_before(&blocks).or_else(|| {
+            let index = plain_text.partition_point(|range| range.start < limit);
+            let range = plain_text.get(index.checked_sub(1)?)?;
+            if limit > range.end {
+                return None;
+            }
+            let lower = start.max(range.start);
+            let mut end = limit;
+            while !body.is_char_boundary(end) {
+                end -= 1;
+            }
+            // Keep an HTML character reference entirely within one fragment.
+            if let Some((prefix, suffix)) = body[lower..end].rsplit_once('&') {
+                if suffix.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'#') {
+                    end = lower + prefix.len();
+                }
+            }
+            (end > start).then_some(end)
+        }).or_else(|| last_before(&tag_edges)).unwrap_or_else(|| {
+            // A single unusually long tag is indivisible. Preserve its bytes
+            // and start the next fragment as soon as its closing > is reached.
+            let index = tag_edges.partition_point(|end| *end <= limit);
+            tag_edges.get(index).copied().unwrap_or(body.len())
+        });
+        if cut == body.len() {
+            break;
+        }
+        ends.push(cut);
+        start = cut;
+    }
+    ends.push(body.len());
+    ends
+}
